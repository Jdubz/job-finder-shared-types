#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Pre-push hook: Blocking build and test
echo "🧪 Running pre-push checks..."

# Run build to ensure types compile
echo "🔧 Running build test..."
npm run build || {
  echo "❌ Build failed! Please fix TypeScript errors before pushing."
  exit 1
}

# Run tests
echo "🧪 Running tests..."
npm run test:ci || {
  echo "❌ Tests failed! Please fix test failures before pushing."
  exit 1
}

echo "✅ Pre-push checks passed!"
